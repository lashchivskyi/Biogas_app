import { EXAMPLES } from "../src/core/examples";
const ex = EXAMPLES.find((e) => e.id === (process.argv[2] ?? "slaughter_5000"))!;
const body = { name: "Тест Тестович", company: "ТОВ Тест", phone: "+380501234567", email: "t@example.com", message: "перевірка", consent: true, website: "", input: ex.input };
const res = await fetch("http://localhost:3100/api/leads", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
console.log(res.status, await res.text());
const bad = await fetch("http://localhost:3100/api/leads", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ ...body, consent: false }) });
console.log("no consent ->", bad.status, await bad.text());
const bad2 = await fetch("http://localhost:3100/api/leads", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ ...body, input: { ...ex.input, feedstocks: [{ id: "x", quantity: -5, type: "food_waste" }] } }) });
console.log("bad qty ->", bad2.status, await bad2.text());
const hp = await fetch("http://localhost:3100/api/leads", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ ...body, website: "spam" }) });
console.log("honeypot ->", hp.status, await hp.text());
