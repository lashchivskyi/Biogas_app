# Copy to .env.local for development. In hosting, set each value per environment (Production / Preview).
# Values marked SECRET never get a NEXT_PUBLIC_ prefix and never go into git, tickets or chat.
# Generate random secrets: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Production checks run at server start (src/server/config.ts); local `next start` previews: APP_ENV=local.

# --- Stage ---
# production | staging | local. Default: Vercel preview = staging, other NODE_ENV=production = production.
APP_ENV=

# --- Site / SEO (NEXT_PUBLIC_* are embedded at build time: change → redeploy) ---
NEXT_PUBLIC_SITE_URL=https://methalytics.com
NEXT_PUBLIC_SUPPORT_EMAIL=hello@methalytics.com
# Google Search Console verification token (optional)
NEXT_PUBLIC_GSC_VERIFICATION=

# Localhost IP geolocation: browser calls ipapi.co (country only).
# 1 also enables local production previews; next dev defaults to enabled. 0 disables.
# Public hosts always use their CDN geo headers instead.
NEXT_PUBLIC_LOCAL_IP_GEO=1

# --- CRM (/admin, HTTP Basic auth; CRM is closed in production without these) ---
ADMIN_USER=
# SECRET, at least 16 characters
ADMIN_PASSWORD=

# --- Payments (docs/payments.md) ---
# stripe | off (off = kill switch: checkout answers 503, the rest of the site keeps working)
PAYMENT_PROVIDER=stripe
# SECRET. Production: sk_live_/rk_live_; staging: sk_test_/rk_test_
STRIPE_SECRET_KEY=
# SECRET. whsec_ of the webhook endpoint for THIS environment
STRIPE_WEBHOOK_SECRET=
# 1 = Stripe Tax (register tax jurisdictions in the Stripe Dashboard first)
STRIPE_TAX=0
# SECRET, 32+ chars, different from every other secret: signs 30-minute price quotes
CHECKOUT_QUOTE_SECRET=

# Demo checkout without a payment provider (local/staging only; refused in production)
PAYMENTS_DEMO=0

# --- Storage ---
# SECRET. Postgres for orders and leads (required in production/staging). Unset locally → JSON files in data/.
DATABASE_URL=
# Alternative for ONE instance with a persistent volume: STORAGE=json + absolute ORDERS_FILE/LEADS_FILE paths.
STORAGE=
LEADS_FILE=
ORDERS_FILE=

# --- Location ---
# Offline GeoNames + precomputed ERA5; no external API key or subscription required.
# SECRET, 32+ chars, keep stable: changing it invalidates locations saved in visitors' drafts.
LOCATION_SIGNING_SECRET=

# --- Email (Resend; required in production: customers receive the private report link) ---
# SECRET
RESEND_API_KEY=
# Verified sender, e.g. Methalytics <reports@mail.methalytics.com>
EMAIL_FROM=
# Where paid-order, lead, refund, dispute and mismatch alerts go
OWNER_EMAIL=

# --- Operations ---
# SECRET. Vercel Cron sends it as "Authorization: Bearer …" to /api/cron/reconcile (vercel.json)
CRON_SECRET=
# SECRET-ish. Server error reporting (Sentry project DSN); unset → host logs only
SENTRY_DSN=
